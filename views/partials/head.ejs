<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<%# títulos longos (posts) dispensam o sufixo: o Google corta em ~60 caracteres %>
<% const _titulo = !title ? settings.site_title
     : (title.length > 40 ? title : `${title} — ${settings.site_title}`); %>
<title><%= _titulo %></title>
<meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : settings.site_description %>">
<meta name="author" content="<%= settings.owner_name %>">
<meta property="og:site_name" content="<%= settings.site_title %>">
<meta property="og:title" content="<%= title || settings.site_title %>">
<meta property="og:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : settings.site_description %>">
<meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
<%# sem imagem própria, a prévia usa a logo; os buscadores pedem endereço absoluto %>
<% const _og = (typeof ogImage !== 'undefined' && ogImage) ? ogImage : '/img/logo.png'; %>
<meta property="og:image" content="<%= _og.startsWith('http') ? _og : origin + _og %>">
<meta name="twitter:card" content="summary_large_image">
<link rel="alternate" type="application/rss+xml" title="<%= settings.site_title %>" href="/feed.xml">
<link rel="preload" href="/fonts/lato-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/lato-700.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/site.css">
<meta name="theme-color" content="#15603a">
<meta name="theme-color" content="#141715" media="(prefers-color-scheme: dark)">
<link rel="icon" type="image/png" href="/img/icone-32.png">
<link rel="apple-touch-icon" href="/img/icone-180.png">
</head>
<body>
<a class="skip" href="#conteudo">Ir para o conteúdo</a>

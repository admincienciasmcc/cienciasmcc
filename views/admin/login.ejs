<%- include('partials/head') %>

<div class="login-page">
  <div class="login-card">
    <div class="mark">C</div>
    <h1 style="font-size:1.3rem">Entrar no painel</h1>
    <p class="muted small">Área restrita de <%= settings.site_title %>.</p>

    <% if (erro) { %><div class="flash flash-erro"><%= erro %></div><% } %>

    <form method="post" action="/admin/entrar">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field">
        <label for="email">E-mail</label>
        <input id="email" type="email" name="email" required autocomplete="username" autofocus>
      </div>
      <div class="field">
        <label for="senha">Senha</label>
        <input id="senha" type="password" name="senha" required autocomplete="current-password">
      </div>
      <button class="btn btn-primary" type="submit" style="width:100%">Entrar</button>
    </form>

    <p class="muted small" style="margin:1.25rem 0 0">
      Esqueceu a senha? O arquivo <code>data/PRIMEIRO-ACESSO.txt</code> guarda a senha inicial
      gerada na instalação.
    </p>
  </div>
</div>

</body>
</html>

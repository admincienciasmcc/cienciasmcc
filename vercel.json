{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": { "maxDuration": 30 },
    "api/cron.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "*/15 * * * *" }
  ],
  "rewrites": [
    { "source": "/api/cron", "destination": "/api/cron" },
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}

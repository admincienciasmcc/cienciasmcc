{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{views,public,src}/**"
    },
    "api/cron.js": {
      "maxDuration": 60,
      "includeFiles": "src/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/cron",
      "destination": "/api/cron"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}

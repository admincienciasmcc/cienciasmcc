# Copie para .env e preencha. Em produção, estas variáveis vão nos
# "Environment Variables" do projeto no Vercel.

# ------------------------------------------------------------------ banco
# Supabase → Project Settings → Database → Connection string → "Transaction
# pooler" (porta 6543). O pooler é o certo para ambiente serverless: o modo
# direto esgota as conexões.
# Sem esta variável, o projeto sobe um Postgres embutido em data/pg e roda
# na máquina local sem instalar nada.
DATABASE_URL=

# -------------------------------------------------------------- imagens
# Supabase → Project Settings → API.
# A service_role ignora as políticas de acesso: ela só pode existir no
# servidor, nunca no navegador nem no repositório.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=imagens

# ------------------------------------------------------------- opcionais
# Endereço público do site — usado no RSS, no sitemap e nas prévias
SITE_URL=

# Assistente de IA no editor. Sem ela, todas as análises automáticas
# continuam funcionando; só os botões de reescrita ficam desligados.
ANTHROPIC_API_KEY=

# Protege /api/cron quando chamado fora da agenda do Vercel
CRON_SECRET=

# Primeiro acesso ao painel (usados só por "npm run seed")
ADMIN_EMAIL=
ADMIN_PASSWORD=

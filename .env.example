# Copie para .env e preencha. Nenhuma destas variáveis é obrigatória.

# Porta do servidor (padrão: 3000)
PORT=3000

# Endereço público do site — usado no RSS, no sitemap e nas prévias de compartilhamento
SITE_URL=https://exemplo.com.br

# Assistente de IA no editor (opcional). Sem ela, todas as análises automáticas
# continuam funcionando; só os botões de reescrita ficam desligados.
ANTHROPIC_API_KEY=

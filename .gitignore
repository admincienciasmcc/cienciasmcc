# dependências — reinstaladas com "npm install"
node_modules/

# banco de dados: guarda o hash da senha, as sessões e o conteúdo publicado.
# É recriado com "npm run seed"; nunca deve ir para um repositório público.
data/*.db
data/*.db-shm
data/*.db-wal
data/PRIMEIRO-ACESSO.txt

# chaves e variáveis de ambiente
.env
.env.*
!.env.example

# currículos e originais pessoais usados como fonte
documentos/

# sistema
.DS_Store
*.log
npm-debug.log*
